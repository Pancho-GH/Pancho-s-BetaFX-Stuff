// AVS4YOU Cylinder Distortion Approximation for BetaFX OpenCL
// kFloat0: Center (0.0 to 1.0, default 0.50 -> maps to AVS 640 on 1280px)
// kFloat1: Radius (0.0 to 1.0, default 0.625 -> maps to AVS 800 on 1280px)
// kFloat2: Degree (-1.0 to 10.0, default 2.0)
// kFloat3: Vertical (1.0 = Vertical ON [default], 0.0 = Horizontal OFF)

float2 uv = (float2)(x, y);
float center = kFloat0;
float radius = max(kFloat1, 0.0001f);
float degree = kFloat2;
bool isVertical = (kFloat3 >= 0.5f);

// Select axis based on Vertical toggle
float coord = isVertical ? uv.x : uv.y;
float dist = coord - center;
float normDist = dist / radius;

if (fabs(normDist) < 1.0f) {
    // Cylindrical arc projection inside the radius
    float angle = asin(clamp(normDist, -1.0f, 1.0f));
    float curved = sin(angle * (1.0f + degree * 0.25f)) * radius;
    
    // Apply distortion along the active axis
    if (isVertical) {
        uv.x = clamp(center + curved, 0.0f, 1.0f);
    } else {
        uv.y = clamp(center + curved, 0.0f, 1.0f);
    }
}

kReadIndex = uv;
kRead();
