// AVS4YOU Broken Glass Recreation for BetaFX Custom OpenCL Kernel
// KFLOAT0 = Debris (Number of glass fragments, e.g., 10 to 100)
// KFLOAT1 = Shatter Spread / Displacement Strength (e.g., 10 to 50)
// KFLOAT2 = Seed / Pattern Variation (e.g., 1 to 100)

float debris = max(kFloat0, 1.0f);
float spread = kFloat1 * 0.002f;
float seed = kFloat2 + 12.34f;

// Normalize coordinates to 0.0 - 1.0 (adjusting for 16:9 aspect ratio)
float2 res = (float2)(1920.0f, 1080.0f);
float2 uv = (float2)((float)x, (float)y) / res;
float2 p = uv * (float2)(1.7778f, 1.0f) * sqrt(debris * 1.5f);

float2 ip = floor(p);
float2 fp = fract(p, (float2*)0);

float minDist = 8.0f;
float2 bestCell = (float2)(0.0f, 0.0f);

// Voronoi 3x3 neighborhood search to generate sharp glass shards
for (int j = -1; j <= 1; j++) {
    for (int i = -1; i <= 1; i++) {
        float2 neighbor = (float2)((float)i, (float)j);
        float2 cellID = ip + neighbor;
        
        // Deterministic pseudo-random point per cell
        float n1 = sin(dot(cellID, (float2)(127.1f, 311.7f)) + seed) * 43758.5453f;
        float n2 = sin(dot(cellID, (float2)(269.5f, 183.3f)) + seed) * 43758.5453f;
        float2 randPt = (float2)(n1 - floor(n1), n2 - floor(n2));
        
        float2 diff = neighbor + randPt - fp;
        float dist = dot(diff, diff); // Euclidean squared for straight-edged shards
        
        if (dist < minDist) {
            minDist = dist;
            bestCell = cellID;
        }
    }
}

// Generate a unique UV offset for each glass shard
float offX = sin(dot(bestCell, (float2)(41.1f, 89.7f)) + seed) * 43758.5453f;
float offY = cos(dot(bestCell, (float2)(93.2f, 27.4f)) + seed) * 43758.5453f;
float2 shardOffset = ((float2)(offX - floor(offX), offY - floor(offY)) - 0.5f) * 2.0f * spread;

// Apply offset and clamp to screen edges
float2 finalUV = clamp(uv + shardOffset, (float2)(0.0f, 0.0f), (float2)(1.0f, 1.0f));
kReadIndex = finalUV * res;

kRead();
